#include <bits/stdc++.h>
using namespace std;

vector<int> dijkstra(vector<vector<vector<int>>> &adj, int src)
{
    int V = adj.size();

    // Min-heap storing {distance, vertex}
    priority_queue<vector<int>, vector<vector<int>>, greater<vector<int>>> pq;

    // Initialize distances to infinity
    vector<int> dist(V, INT_MAX);

    // Distance from source to itself is 0
    dist[src] = 0;
    pq.push({0, src});

    while (!pq.empty())
    {
        int d = pq.top()[0];
        int u = pq.top()[1];
        pq.pop();

        // Skip outdated entries
        if (d > dist[u])
            continue;

        // Traverse adjacent vertices
        for (const auto &x : adj[u])
        {
            int v = x[0];
            int weight = x[1];

            // Update distance if a shorter path is found
            if (dist[v] > d + weight)
            {
                dist[v] = d + weight;
                pq.push({dist[v], v});
            }
        }
    }

    return dist;
}

int main()
{
    vector<vector<vector<int>>> adj = {{{1, 4}, {2, 8}},
                                       {{0, 4}, {4, 6}, {2, 3}},
                                       {{0, 8}, {3, 2}, {1, 3}},
                                       {{2, 2}, {4, 10}},
                                       {{1, 6}, {3, 10}}};

    int src = 0;

    vector<int> dist = dijkstra(adj, src);

    cout << "[";
    for (int i = 0; i < dist.size(); i++)
    {
        cout << dist[i];
        if (i < dist.size() - 1)
            cout << ", ";
    }
    cout << "]" << endl;

    return 0;
}
