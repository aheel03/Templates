int rand(int a,int b){
    return a + rand()%(b-a+1);
}

int main(int argc, char* argv[]){
    srand(atoi(argv[1]));
    int n=rand(5,10);
    cout<<n<<" "<<n<<endl;
    for(int i=0;i<n;i++){
        int g=rand(0,40);
        cout<<g-20<<" ";
    }
    newl;
    vector<int> nodes;
    set<ll> st;
    while(nodes.size()<n){
        if(nodes.size()==0){
            int node=rand(1,n);
            nodes.push_back(node);
            st.insert(node);
        }
        int sz=nodes.size();
        int idx=rand(0,sz-1);
        ll notun_node=1;
        while(st.find(notun_node)!=st.end()){// node ase
            notun_node=rand(1,n);
        }
        cout<<nodes[idx]<<" "<<notun_node<<endl;
        nodes.push_back(notun_node);
        st.insert(notun_node);

        //debug(idx,nodes,nodes[idx],notun_node);
    }
    loop(i,1,n+1){
        cout<<i<<endl;
    }
}
